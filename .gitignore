# Xcode
xcuserdata/
*.xcuserstate
*.xcuserdatad/
DerivedData/
.build/
*.xcscmblueprint
*.xccheckout

# Swift Package Manager local build cache (Package.resolved is committed
# intentionally, for reproducible dependency versions)
.swiftpm/

# macOS
.DS_Store

# Simulator/screenshots produced while developing, not part of the app
*.png.tmp

# Code signing material — never commit a certificate, private key, or profile.
*.p12
*.cer
*.certSigningRequest
*.mobileprovision
*.provisionprofile

# Xcode "Archive / Distribute App" output — build artifacts, not source.
*.xcarchive
*.ipa
